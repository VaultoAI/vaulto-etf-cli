{
  "name": "etf-cli",
  "version": "0.3.1",
  "description": "Agent-first CLI for Vaulto on-chain basket ETFs. Mint/redeem shares, zap USDG, rebalance, factory, keeper — Base + BNB + Robinhood Chain.",
  "type": "module",
  "bin": {
    "vaulto-cli": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "files": [
    "dist",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VaultoAI/vaulto-etf-cli.git"
  },
  "bugs": {
    "url": "https://github.com/VaultoAI/vaulto-etf-cli/issues"
  },
  "homepage": "https://github.com/VaultoAI/vaulto-etf-cli#readme",
  "keywords": [
    "vaulto",
    "etf",
    "defi",
    "cli",
    "agent",
    "viem",
    "basket",
    "rebalance",
    "base",
    "bnb",
    "robinhood"
  ],
  "author": "Vaulto",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0"
  }
}
