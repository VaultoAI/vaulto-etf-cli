{
  "name": "vaulto-etf-cli",
  "version": "0.1.0",
  "description": "Agent-first CLI for Vaulto V2 on-chain basket ETFs. Reads vault state directly on-chain (Base + BNB), triggers rebalances, deploys vaults, and runs the keeper.",
  "type": "module",
  "bin": {
    "vaulto-etf": "dist/cli.js"
  },
  "files": [
    "dist",
    "AGENTS.md",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0"
  }
}
