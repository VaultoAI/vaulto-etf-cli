# RPC endpoints (optional — public fallbacks are used if unset).
BASE_RPC_URL=https://mainnet.base.org
BNB_RPC_URL=https://bsc-dataseed.binance.org

# Signer key for WRITE operations (rebalance start/settle, deploy).
# Optional — read commands never need it. Must hold EXECUTOR_ROLE for rebalance.
PRIVATE_KEY=

# Path to a local clone of github.com/VaultoAI/Vaulto-ETF-V2.
# Required only for `deploy` (forge scripts) and `keeper` (npm scripts).
VAULTO_V2_DIR=
