# RPC endpoints (optional — public fallbacks are used if unset).
BASE_RPC_URL=https://mainnet.base.org
BNB_RPC_URL=https://bsc-dataseed1.binance.org
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Signer key for WRITE operations (rebalance start/settle/execute, deploy,
# factory create, zap mint/redeem). Optional — read commands never need it.
# Must hold EXECUTOR_ROLE for rebalance ops.
PRIVATE_KEY=

# Path to a local clone of github.com/DavidVaulto/ETFs
# (or VaultoAI/Vaulto-ETF-V2). Required only for `deploy` and `keeper`.
VAULTO_V2_DIR=
